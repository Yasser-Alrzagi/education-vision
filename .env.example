# App Hosting & Gemini AI Configuration
GEMINI_API_KEY="your-gemini-api-key-here"
APP_URL="https://your-domain.com"
NODE_ENV="production"
APP_PORT="3000"

# ==========================================
# Admin Authentication & Security Variables
# ==========================================
# In production, these variables are required. If not provided, admin login fails securely.
ADMIN_EMAIL="admin@educationvision.com"
ADMIN_PASSWORD="YourStrongSecurePassword2026!"
ADMIN_NAME="مالك المنصة"

# JWT Secret Key for Session Authentication (Must be a long random 32+ char secret in production)
JWT_SECRET="generate-a-strong-random-32-byte-hex-string-for-production"

# Optional External Database (If using remote Postgres / Supabase / Neon / Redis)
# DATABASE_URL="postgresql://user:password@host:5432/dbname"

